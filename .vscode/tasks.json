{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies (npm install)",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Jalankan Dev Server (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build Production",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Typecheck (tsc --noEmit)",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$tsc"]
    }
  ]
}
